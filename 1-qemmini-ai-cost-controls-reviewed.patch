diff --git a/src/test/ai-provider-budget.test.ts b/src/test/ai-provider-budget.test.ts
new file mode 100644
index 0000000..c4d5e5e
--- /dev/null
+++ b/src/test/ai-provider-budget.test.ts
@@ -0,0 +1,212 @@
+// @vitest-environment node
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { auditDb } from "./audit-sqlite-helper";
+import {
+  aiProviderFetch,
+  readAiProviderPolicy,
+  reserveProviderAttempt,
+} from "@/server/ai-provider-fetch";
+import { setD1Binding } from "@/server/d1";
+import { suggestGradeWithAi } from "@/server/ai-client";
+
+const request = {
+  questionPrompt: "Capital?",
+  rubric: "",
+  acceptedAlternatives: [],
+  studentAnswer: "Cairo",
+  maxMarks: 10,
+};
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+  setD1Binding(null);
+});
+function localConfig() {
+  vi.stubEnv("AI_BASE_URL", "http://localhost:11434/v1");
+  vi.stubEnv("AI_MODEL", "test");
+}
+describe("Provider attempt safety and cost measurement", () => {
+  it("preserves current service by default and rejects malformed policy", () => {
+    expect(readAiProviderPolicy({})).toEqual({ enabled: true, dailyRequests: null });
+    for (const raw of ["-1", "1.2", "NaN", "5x", "Infinity", "9007199254740992"]) {
+      expect(() => readAiProviderPolicy({ AI_PROVIDER_DAILY_REQUEST_LIMIT: raw })).toThrow();
+    }
+    expect(() => readAiProviderPolicy({ AI_REQUESTS_ENABLED: "flase" })).toThrow();
+    expect(readAiProviderPolicy({ AI_PROVIDER_DAILY_REQUEST_LIMIT: "0" }).dailyRequests).toBe(0);
+  });
+  it("uses actual SQLite to bound concurrent reservations, rollover and migration replay", async () => {
+    const { db, sql } = auditDb();
+    const migration = readFileSync("schema/migrations/20261116_ai_provider_budget.sql", "utf8");
+    sql.exec(migration);
+    sql.exec(migration);
+    const date = new Date("2026-11-16T12:00:00Z");
+    const results = await Promise.all(
+      Array.from({ length: 30 }, () => reserveProviderAttempt(db, 7, date)),
+    );
+    expect(results.filter(Boolean)).toHaveLength(7);
+    expect(
+      sql.prepare("SELECT request_count FROM ai_provider_daily_budget").get()?.["request_count"],
+    ).toBe(7);
+    expect(await reserveProviderAttempt(db, 7, new Date("2026-11-17T00:00:00Z"))).toBe(true);
+    expect(await reserveProviderAttempt(db, 0, date)).toBe(false);
+    sql.close();
+  });
+  it("kill switch and zero budget perform no network request or DB access", async () => {
+    const network = vi.fn();
+    vi.stubGlobal("fetch", network);
+    vi.stubEnv("AI_REQUESTS_ENABLED", "false");
+    await expect(aiProviderFetch("https://example.invalid", {})).rejects.toThrow(
+      "AI_PROVIDER_PAUSED",
+    );
+    vi.stubEnv("AI_REQUESTS_ENABLED", "true");
+    vi.stubEnv("AI_PROVIDER_DAILY_REQUEST_LIMIT", "0");
+    await expect(aiProviderFetch("https://example.invalid", {})).rejects.toThrow(
+      "AI_PROVIDER_BUDGET_EXCEEDED",
+    );
+    expect(network).not.toHaveBeenCalled();
+  });
+  it("fails closed when the budget table is missing", async () => {
+    const { db, sql } = auditDb();
+    sql.exec("DROP TABLE ai_provider_daily_budget");
+    setD1Binding(db);
+    vi.stubEnv("AI_PROVIDER_DAILY_REQUEST_LIMIT", "4");
+    const network = vi.fn();
+    vi.stubGlobal("fetch", network);
+    await expect(aiProviderFetch("https://example.invalid", {})).rejects.toThrow(
+      "AI_PROVIDER_BUDGET_EXCEEDED",
+    );
+    expect(network).not.toHaveBeenCalled();
+    sql.close();
+  });
+  it("counts a failed network attempt permanently, even when product quota would refund", async () => {
+    const { db, sql } = auditDb();
+    setD1Binding(db);
+    vi.stubEnv("AI_PROVIDER_DAILY_REQUEST_LIMIT", "1");
+    const network = vi.fn().mockRejectedValue(new Error("network"));
+    vi.stubGlobal("fetch", network);
+    await expect(aiProviderFetch("https://example.invalid", {})).rejects.toThrow("network");
+    await expect(aiProviderFetch("https://example.invalid", {})).rejects.toThrow(
+      "AI_PROVIDER_BUDGET_EXCEEDED",
+    );
+    expect(network).toHaveBeenCalledTimes(1);
+    sql.close();
+  });
+  it("retries must each reserve budget and never exceed the configured bound", async () => {
+    const { db, sql } = auditDb();
+    setD1Binding(db);
+    localConfig();
+    vi.stubEnv("AI_PROVIDER_DAILY_REQUEST_LIMIT", "1");
+    const network = vi.fn().mockResolvedValue(new Response("", { status: 503 }));
+    vi.stubGlobal("fetch", network);
+    expect((await suggestGradeWithAi(request)).ok).toBe(false);
+    expect(network).toHaveBeenCalledTimes(1);
+    sql.close();
+  });
+  it.each(["", "bad json", '{"suggested_score":null}'])(
+    "measures paid unusable reply %j and caps grading output",
+    async (content) => {
+      localConfig();
+      const usage = vi.fn().mockResolvedValue(undefined);
+      const network = vi.fn().mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            choices: [{ message: { content } }],
+            usage: { prompt_tokens: 42, completion_tokens: 12 },
+          }),
+        ),
+      );
+      vi.stubGlobal("fetch", network);
+      expect((await suggestGradeWithAi(request, usage)).ok).toBe(false);
+      expect(usage).toHaveBeenCalledWith(
+        expect.objectContaining({ usage: { inputTokens: 42, outputTokens: 12 } }),
+      );
+      expect(JSON.parse(network.mock.calls[0]![1].body).max_tokens).toBe(1200);
+    },
+  );
+  it("measurement failure never discards a valid suggestion", async () => {
+    localConfig();
+    vi.stubGlobal(
+      "fetch",
+      vi
+        .fn()
+        .mockResolvedValue(
+          new Response(
+            JSON.stringify({ choices: [{ message: { content: '{"suggested_score":8}' } }] }),
+          ),
+        ),
+    );
+    expect(
+      (
+        await suggestGradeWithAi(request, async () => {
+          throw new Error("sink");
+        })
+      ).ok,
+    ).toBe(true);
+  });
+  it("all eight AI modules use the common gate, with no direct provider fetch bypass", () => {
+    for (const file of [
+      "src/server/ai-client.ts",
+      "src/server/handwritten.ts",
+      "src/server/source-ocr.ts",
+      "src/server/paper-matching.ts",
+      "src/server/tutor.ts",
+      "src/server/teacher-assistant.ts",
+      "src/server/lesson-explain.ts",
+      "src/lib/generate-assessment.ts",
+    ]) {
+      const code = readFileSync(file, "utf8");
+      expect(code).toContain("await aiProviderFetch(");
+      expect(code).not.toMatch(/\bfetch\s*\(/);
+    }
+  });
+  it.each([2, 3])("reserves every retry up to a budget of %i", async (limit) => {
+    const { db, sql } = auditDb();
+    setD1Binding(db);
+    localConfig();
+    vi.stubEnv("AI_PROVIDER_DAILY_REQUEST_LIMIT", String(limit));
+    const network = vi.fn().mockImplementation(async () => new Response("", { status: 503 }));
+    vi.stubGlobal("fetch", network);
+    expect((await suggestGradeWithAi(request)).ok).toBe(false);
+    expect(network).toHaveBeenCalledTimes(limit);
+    expect(
+      sql.prepare("SELECT request_count FROM ai_provider_daily_budget").get()!["request_count"],
+    ).toBe(limit);
+    sql.close();
+  });
+  it("opt-in ledger records unknown usage, network failures and paid malformed responses without content", async () => {
+    const { db, sql } = auditDb();
+    setD1Binding(db);
+    vi.stubEnv("AI_ATTEMPT_LOG_ENABLED", "true");
+    const network = vi
+      .fn()
+      .mockResolvedValueOnce(new Response("not-json"))
+      .mockResolvedValueOnce(
+        new Response(
+          JSON.stringify({
+            usage: { prompt_tokens: 20, completion_tokens: 4 },
+            choices: [{ message: { content: "private answer" } }],
+          }),
+        ),
+      )
+      .mockRejectedValueOnce(new Error("secret body"));
+    vi.stubGlobal("fetch", network);
+    const init = {
+      method: "POST",
+      body: JSON.stringify({ model: "test", messages: [{ content: "private prompt" }] }),
+    };
+    await aiProviderFetch("https://example.invalid/chat/completions", init);
+    const response = await aiProviderFetch("https://example.invalid/chat/completions", init);
+    expect((await response.json()).choices[0].message.content).toBe("private answer");
+    await expect(
+      aiProviderFetch("https://example.invalid/chat/completions", init),
+    ).rejects.toThrow();
+    const rows = sql.prepare("SELECT * FROM ai_provider_attempts ORDER BY rowid").all();
+    expect(rows).toHaveLength(3);
+    expect(rows[0]!["input_tokens"]).toBe(null);
+    expect(rows[1]!["input_tokens"]).toBe(20);
+    expect(rows[2]!["outcome"]).toBe("network_error");
+    expect(JSON.stringify(rows)).not.toMatch(/private|secret/);
+    sql.close();
+  });
+});
diff --git a/src/test/teacher-student-journey-sqlite.test.ts b/src/test/teacher-student-journey-sqlite.test.ts
new file mode 100644
index 0000000..274ac6b
--- /dev/null
+++ b/src/test/teacher-student-journey-sqlite.test.ts
@@ -0,0 +1,104 @@
+// @vitest-environment node
+import { expect, it } from "vitest";
+import { auditDb } from "./audit-sqlite-helper";
+import { createD1AuthStore } from "@/server/d1-auth-store";
+import { signUp, signIn } from "@/lib/cloudflare-auth";
+import {
+  createAssessment,
+  addQuestion,
+  updateQuestion,
+  setAssessmentStatus,
+  joinTeacher,
+  getStudentHome,
+} from "@/server/d1-assessments";
+import { decideEnrollment } from "@/server/d1-students";
+import { getTakeData, startAttempt, saveDraft, submitAttempt } from "@/server/d1-take";
+import { reviewAnswer, releaseSubmission } from "@/server/d1-grading";
+
+it("actual SQL journey: signup approval, join, exam, draft resume, submit, teacher review and released result", async () => {
+  const { db, sql } = auditDb();
+  const store = createD1AuthStore(db);
+  const t = await signUp(store, {
+    email: "journey-teacher@example.invalid",
+    password: "test-only-password",
+    fullName: "Synthetic teacher",
+    role: "school_teacher",
+    teacherPhone: "01000000000",
+    iterations: 1000,
+  });
+  const s = await signUp(store, {
+    email: "journey-student@example.invalid",
+    password: "test-only-password",
+    fullName: "Synthetic student",
+    role: "student",
+    parentPhone: "01000000000",
+    iterations: 1000,
+  });
+  expect(t.status).toBe("pending");
+  expect(s.status).toBe("pending");
+  await expect(
+    signIn(store, { email: "journey-student@example.invalid", password: "test-only-password" }),
+  ).rejects.toBeDefined();
+  // Simulate the admin's explicit approval ONLY in this disposable database.
+  sql.prepare("UPDATE auth_users SET status='approved' WHERE id IN (?,?)").run(t.userId, s.userId);
+  const login = await signIn(store, {
+    email: "journey-student@example.invalid",
+    password: "test-only-password",
+  });
+  expect(login).toBeDefined();
+  sql.prepare("UPDATE profiles SET join_code='JRNY00000001' WHERE id=?").run(t.userId);
+  await joinTeacher(db, s.userId, "JRNY00000001");
+  expect((await getStudentHome(db, s.userId, 0, 0)).teacherLinks).toBe(0);
+  await decideEnrollment(db, { id: t.userId, role: "school_teacher" }, s.userId, true);
+  const exam = await createAssessment(db, t.userId, "Synthetic journey exam");
+  const q = await addQuestion(db, t.userId, exam.id, "written");
+  await updateQuestion(db, t.userId, q.id, {
+    type: "written",
+    prompt: "Explain photosynthesis",
+    marks: 10,
+    objective: "",
+    options: [],
+    difficulty: "medium",
+    correctAnswer: "",
+    acceptedAlternatives: [],
+    rubric: "Light and carbon dioxide form glucose",
+    explanation: "",
+  });
+  await setAssessmentStatus(db, t.userId, exam.id, "published");
+  expect((await getStudentHome(db, s.userId, 0, 0)).assessments.map((a) => a.id)).toContain(
+    exam.id,
+  );
+  expect((await getTakeData(db, "s", exam.id)).allowed).toBe(false);
+  const taken = await getTakeData(db, s.userId, exam.id);
+  expect(taken.allowed).toBe(true);
+  const sub = await startAttempt(db, s.userId, exam.id, [q.id]);
+  expect(
+    await saveDraft(db, s.userId, sub.submissionId, [
+      { question_id: q.id, response: "Light and CO2 make glucose", time_spent_seconds: 15 },
+    ]),
+  ).toBe(true);
+  expect((await startAttempt(db, s.userId, exam.id, [q.id])).submissionId).toBe(sub.submissionId);
+  expect(await saveDraft(db, "s", sub.submissionId, [])).toBe(false);
+  expect(await submitAttempt(db, s.userId, sub.submissionId)).toBe(true);
+  expect(await saveDraft(db, s.userId, sub.submissionId, [])).toBe(false);
+  await expect(releaseSubmission(db, t.userId, sub.submissionId, "")).rejects.toThrow(
+    "NOT_APPROVED",
+  );
+  const answer = sql.prepare("SELECT id FROM answers WHERE submission_id=?").get(sub.submissionId)![
+    "id"
+  ] as string;
+  await expect(reviewAnswer(db, "t", answer, 8, "", "approve")).rejects.toThrow();
+  await reviewAnswer(db, t.userId, answer, 8, "Teacher checked", "approve");
+  expect(await releaseSubmission(db, t.userId, sub.submissionId, "Reviewed")).toEqual({
+    finalScore: 8,
+    totalPossible: 10,
+  });
+  const home = await getStudentHome(db, s.userId, 0, 0);
+  expect(home.submissions).toEqual(
+    expect.arrayContaining([
+      expect.objectContaining({ status: "released", final_score: 8, total_possible: 10 }),
+    ]),
+  );
+  expect(sql.prepare("SELECT COUNT(*) AS n FROM whatsapp_sends").get()!["n"]).toBe(0);
+  sql.close();
+});
